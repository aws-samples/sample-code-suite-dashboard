# Example tfvars for the dashboard backend.
#
# Copy to terraform.tfvars (which is gitignored) and fill in real values.
# `make deploy-dashboard` picks up terraform.tfvars automatically.
#
# -----------------------------------------------------------------------------
# Auth model
# -----------------------------------------------------------------------------
# The stats API is protected by API Gateway AWS_IAM authorization. Every
# request must be SigV4-signed and the caller's IAM identity must have
# execute-api:Invoke on the API ARN. After `make deploy-dashboard`, the
# Terraform output `api_invoke_policy_arn` gives you a paste-ready managed
# policy to attach to your IAM user / role / SSO permission set:
#
#   aws iam attach-user-policy \
#     --user-name $(aws sts get-caller-identity --query Arn --output text | awk -F/ '{print $NF}') \
#     --policy-arn "$(terraform -chdir=terraform/dashboard-backend output -raw api_invoke_policy_arn)"
#
# The dashboard's Vite dev server signs requests automatically using your
# local AWS credential chain (env vars, ~/.aws/credentials, SSO, etc.) —
# no tokens, no secrets in the browser.
#
# -----------------------------------------------------------------------------
# CORS — the origin the dashboard is served from.
# Default is http://localhost:5173 (vite dev server). The browser doesn't
# normally hit API Gateway directly (Vite proxies + signs), so this only
# matters if you want to debug the API from a browser console.
# -----------------------------------------------------------------------------
# cors_allow_origin = "http://localhost:5173"
