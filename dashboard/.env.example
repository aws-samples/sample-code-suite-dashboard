# Copy this file to `.env` and set the value to your deployed dashboard API.
# After `make deploy-dashboard`, get the URL from:
#   terraform -chdir=terraform/dashboard-backend output -raw stats_api_url
# Drop the trailing `/stats` — set just the base origin here.
VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# Region used for SigV4 signing. Auto-derived from the API hostname if
# omitted; set this if your API lives in a non-standard partition.
# VITE_AWS_REGION=us-east-1

# Path the React app fetches from. The Vite dev server signs and proxies
# every request under this prefix to VITE_API_URL. Don't change it unless
# you also update the proxy mount in vite.config.js.
# VITE_API_BASE=/api

# -----------------------------------------------------------------------------
# How auth works
# -----------------------------------------------------------------------------
# The stats API is protected by API Gateway AWS_IAM authorization. The Vite
# dev server signs every /api/* request with SigV4 using your local AWS
# credential chain (env vars, ~/.aws/credentials, SSO). Standard AWS env
# vars work transparently:
#
#   export AWS_PROFILE=my-profile
#   make run-dashboard
#
# Your IAM principal needs `execute-api:Invoke` on the API ARN. After
# deploying, attach the managed policy emitted as `api_invoke_policy_arn`:
#
#   POLICY=$(terraform -chdir=terraform/dashboard-backend output -raw api_invoke_policy_arn)
#   aws iam attach-user-policy --user-name "$(whoami)" --policy-arn "$POLICY"
#
# No tokens to manage, no secrets in the browser.
